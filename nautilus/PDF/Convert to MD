#!/usr/bin/env bash

result=$("$HOME/.local/bin/pdf2md" "$@" 2>&1)
status=$?

if [ "$status" -eq 0 ] && [[ "$result" == *"Converted:"* ]]; then
    notify-send \
        -a "PDF to MD" \
        -i text-x-generic \
        "Conversion Complete" \
        "Your PDF has been converted to MD."

elif [ "$status" -eq 0 ] && [[ "$result" == *"Skipping (already exists):"* ]]; then
    notify-send \
        -a "PDF to MD" \
        -i dialog-information \
        "Already Converted" \
        "The MD file already exists. Nothing was overwritten."

else
    notify-send \
        -a "PDF to MD" \
        -i dialog-warning \
        "Conversion Issue" \
        "One or more files could not be converted. Run pdf2md in the terminal for details."
fi
